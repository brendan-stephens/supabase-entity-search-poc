# Copy to .env.local and fill in your Supabase project values.
# All values are in: Project Settings → API / Database

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Project Settings → Database → Connection string (Session pooler, port 5432)
# Used by the seed script
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Project Settings → Database → Connection string (Transaction pooler, port 6543)
# Used by the benchmark (supports high concurrency, no per-session connection cap)
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
